{
  "name": "Media",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/Media/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/Media",
        "outputPath": "dist/apps/Media",
        "main": "apps/Media/src/main.ts",
        "tsConfig": "apps/Media/tsconfig.app.json",
        "compiler": "tsc",
        "additionalEntryPoints": [
          {
            "entryName": "db/data-source",
            "entryPath": "apps/Media/src/db/data-source.ts"
          }
        ]
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/Media/package.json",
        "{workspaceRoot}/dist/apps/Media/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/Media/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "Media:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "Media:build:development"
        },
        "production": {
          "buildTarget": "Media:build:production"
        }
      }
    }
  },
  "tags": []
}
