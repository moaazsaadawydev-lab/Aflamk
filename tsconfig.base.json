{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@booking-ticket-system/DTOs": ["./libs/DTOs/src/index.ts"],
      "@booking-ticket-system/Common": ["./libs/Common/src/index.ts"],
      "@booking-ticket-system/Types": ["./libs/Types/src/index.ts"],
      "@booking-ticket-system/Interfaces": ["./libs/Interfaces/src/index.ts"],
      "@booking-ticket-system/Entities": ["./libs/Entities/src/index.ts"],
      "@booking-ticket-system/Utils": ["./libs/Utils/src/index.ts"],
      "@booking-ticket-system/Constants": ["./libs/Constants/src/index.ts"],
      "@booking-ticket-system/Guards": ["./libs/Guards/src/index.ts"],
      "@booking-ticket-system/Decorators": ["./libs/Decorators/src/index.ts"],
      "@booking-ticket-system/Storage": ["./libs/Storage/src/index.ts"],
      "@booking-ticket-system/Filters": ["./libs/Filters/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
